{
  "name": "lx-music-api-server-workers",
  "description": "基于 Cloudflare Workers 的多音源音乐 API 服务",
  "repository": "https://github.com/nanci0406/lx-music-api-server-workers",
  "logo": "https://workers.cloudflare.com/resources/logo/logo.svg",
  "success_url": "/admin",
  "env": {
    "AUTH_ENABLED": {
      "description": "是否启用用户认证",
      "value": "true",
      "required": true
    },
    "ENVIRONMENT": {
      "description": "运行环境",
      "value": "production",
      "required": true
    }
  },
  "formation": {
    "worker": {
      "quantity": 1
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/cloudflareworkers/buildpack-nodejs.git"
    }
  ]
}
